    "@tiptap/starter-kit": "3.31.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.41.0",
    "next": "16.3.4",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-rnd": "10.5.3",
    "tailwind-merge": "3.6.0",
