# Local development defaults. Change credentials before any future deployment.
POSTGRES_PASSWORD=mablog-local-development
APP_SECRET=local-development-change-before-production-at-least-32-characters
APP_ORIGIN=http://localhost:3000
# Local limits, in seconds or MiB as indicated by each name.
CODE_TTL_SECONDS=600
CODE_MAX_ATTEMPTS=5
CODE_RESEND_SECONDS=60
IMAGE_LIMIT_MB=10
VIDEO_LIMIT_MB=100
PUBLIC_CACHE_SECONDS=15
# Local password-only test account. Disable this before adapting Compose for production.
LOCAL_ADMIN_ENABLED=true
LOCAL_ADMIN_USERNAME=mablog_admin
LOCAL_ADMIN_EMAIL=admin@mablog.local
LOCAL_ADMIN_PASSWORD=mablog-admin-local-2026
# Ten years in seconds; regular users still require verification every seven days.
LOCAL_ADMIN_VERIFICATION_SECONDS=315360000
# Local-only convenience for protected publication/source actions. Production rejects this flag.
APP_ENV=local
LOCAL_ADMIN_STEP_UP_BYPASS=true

# Backend-only OpenAI Platform configuration. Never expose this key to Next.js or commit .env.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_ANSWER_MODEL=gpt-5.6-terra
OPENAI_TIMEOUT_SECONDS=45
OPENAI_MAX_OUTPUT_TOKENS=500

# Search cost, abuse, retrieval, and rank-tuning controls.
ANONYMOUS_ENHANCED_SEARCHES_PER_HOUR=10
SIGNED_IN_ENHANCED_SEARCHES_PER_HOUR=60
ANONYMOUS_KEYWORD_SEARCHES_PER_HOUR=60
SIGNED_IN_KEYWORD_SEARCHES_PER_HOUR=300
GLOBAL_ENHANCED_SEARCHES_PER_DAY=500
GLOBAL_INDEXED_PASSAGES_PER_DAY=10000
SEARCH_CANDIDATE_LIMIT=200
SEARCH_TOKEN_SECONDS=600
SEARCH_RRF_K=60
# Likes and freshness together remain capped at 10% of the fused relevance score.
SEARCH_LIKE_BOOST_CAP=0.06
SEARCH_FRESHNESS_BOOST_CAP=0.04
SEARCH_FRESHNESS_HALF_LIFE_DAYS=30
INDEX_WORKER_POLL_SECONDS=2

# Weekly MABlog_IA publisher. The durable schedule remains disabled in PostgreSQL
# until an administrator completes a real verified preview and enables it in the UI.
NEWS_MASTER_ENABLED=true
NEWS_SMALL_MODEL=gpt-5.6-luna
NEWS_STRONG_MODEL=gpt-5.6-terra
BRAVE_API_KEY=
BRAVE_API_URL=https://api.search.brave.com/res/v1/web/search
NEWS_TIMEZONE=Europe/Madrid
# Python weekday numbering: Monday is 0.
NEWS_WEEKDAY=0
NEWS_HOUR=9
NEWS_MINUTE=0
NEWS_RUN_BUDGET_USD=2
NEWS_MONTH_BUDGET_USD=10
NEWS_BRAVE_QUERY_BUDGET=15
NEWS_WORKER_POLL_SECONDS=3
NEWS_JOB_LEASE_SECONDS=300
NEWS_FETCH_TIMEOUT_SECONDS=20
NEWS_FETCH_MAX_BYTES=10485760
NEWS_FETCH_MAX_REDIRECTS=5
# Full extracted source text stays 30 days; evidence metadata and hashes stay permanently.
NEWS_SNAPSHOT_SECONDS=2592000
NEWS_FAILED_RETENTION_SECONDS=7776000
NEWS_OPERATION_RETENTION_SECONDS=31536000
ADMIN_STEP_UP_SECONDS=600
